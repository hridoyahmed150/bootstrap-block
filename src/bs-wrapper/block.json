{
  "apiVersion": 2,
  "name": "emg/bs-wrapper",
  "title": "BS Wrapper",
  "category": "layout",
  "icon": "layout",
  "description": "An inner content wrapper for Bootstrap-based layouts with custom CSS support.",
  "supports": {
    "html": false,
    "className": true
  },
  "attributes": {
    "customCSS": { "type": "string", "default": "" },
    "uniqueId": { "type": "string", "default": "" },
    "default": { "type": "object", "default": { "paddingTop": 0, "paddingRight": 0, "paddingBottom": 0, "paddingLeft": 0, "marginTop": 0, "marginRight": 0, "marginBottom": 0, "marginLeft": 0 } },
    "sm": { "type": "object", "default": { "paddingTop": 0, "paddingRight": 0, "paddingBottom": 0, "paddingLeft": 0, "marginTop": 0, "marginRight": 0, "marginBottom": 0, "marginLeft": 0 } },
    "md": { "type": "object", "default": { "paddingTop": 0, "paddingRight": 0, "paddingBottom": 0, "paddingLeft": 0, "marginTop": 0, "marginRight": 0, "marginBottom": 0, "marginLeft": 0 } },
    "lg": { "type": "object", "default": { "paddingTop": 0, "paddingRight": 0, "paddingBottom": 0, "paddingLeft": 0, "marginTop": 0, "marginRight": 0, "marginBottom": 0, "marginLeft": 0 } },
    "xl": { "type": "object", "default": { "paddingTop": 0, "paddingRight": 0, "paddingBottom": 0, "paddingLeft": 0, "marginTop": 0, "marginRight": 0, "marginBottom": 0, "marginLeft": 0 } },
    "xxl": { "type": "object", "default": { "paddingTop": 0, "paddingRight": 0, "paddingBottom": 0, "paddingLeft": 0, "marginTop": 0, "marginRight": 0, "marginBottom": 0, "marginLeft": 0 } },
    "wrapperAnimationEnabled": { "type": "boolean", "default": false },
    "wrapperAnimationName": { "type": "string", "default": "" },
    "wrapperAnimationDuration": { "type": "number", "default": 1000 },
    "wrapperAnimationDelay": { "type": "number", "default": 0 }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css"
}
