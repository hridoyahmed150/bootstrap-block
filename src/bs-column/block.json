{
  "apiVersion": 2,
  "name": "bootstrap-blocks/bs-column",
  "title": "Bootstrap Column",
  "category": "layout",
  "icon": "columns",
  "description": "A Bootstrap column block for layout.",
  "supports": {
    "html": false
  },
  "attributes": {
    "className": { "type": "string", "default": "" },
    "default": { "type": "object", "default": { "width": 0, "offset": 0 } },
    "sm": { "type": "object", "default": { "width": 0, "offset": 0 } },
    "md": { "type": "object", "default": { "width": 0, "offset": 0 } },
    "lg": { "type": "object", "default": { "width": 0, "offset": 0 } },
    "xl": { "type": "object", "default": { "width": 0, "offset": 0 } },
    "xxl": { "type": "object", "default": { "width": 0, "offset": 0 } },
    "calculatedWidth": { "type": "number", "default": 6 },
    "colAnimationEnabled": { "type": "boolean", "default": false },
    "colAnimationName": { "type": "string", "default": "" },
    "colAnimationDuration": { "type": "number", "default": 1000 },
    "colAnimationDelay": { "type": "number", "default": 0 },
    "sliderEnabled": { "type": "boolean", "default": false },
    "uniqueId": { "type": "string", "default": "" },
    "slidesToShow": { "type": "number", "default": 3 },
    "autoplay": { "type": "boolean", "default": true },
    "autoplaySpeed": { "type": "number", "default": 3000 },
    "showArrows": { "type": "boolean", "default": false },
    "showDots": { "type": "boolean", "default": true },
    "responsive": {
      "type": "object",
      "default": {
        "mobile": { "slidesToShow": 1, "slidesToScroll": 1, "minWidth": 600 },
        "tablet": { "slidesToShow": 2, "slidesToScroll": 1, "minWidth": 768 },
        "desktop": { "slidesToShow": 3, "slidesToScroll": 1, "minWidth": 1024 }
      }
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css"
} 