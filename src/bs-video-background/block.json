{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bootstrap-blocks/bs-video-background",
    "version": "1.0.0",
    "title": "BS Video Background",
    "category": "media",
    "icon": "video-alt3",
    "description": "Video background block with YouTube support, autoplay, and overlay options.",
    "keywords": ["video", "background", "youtube"],
    "textdomain": "bootstrap-blocks",
    "supports": {
        "html": false,
        "className": true,
        "align": ["wide", "full"]
    },
    "attributes": {
        "videoURL": {
            "type": "string",
            "default": ""
        },
        "videoPoster": {
            "type": "string",
            "default": ""
        },
        "videoStartTime": {
            "type": "number",
            "default": 0
        },
        "videoEndTime": {
            "type": "number",
            "default": 0
        },
        "videoVolume": {
            "type": "number",
            "default": 0
        },
        "videoLoop": {
            "type": "boolean",
            "default": true
        },
        "videoAlwaysPlay": {
            "type": "boolean",
            "default": true
        },
        "minHeight": {
            "type": "number",
            "default": 400
        },
        "overlayColor": {
            "type": "string",
            "default": ""
        },
        "overlayOpacity": {
            "type": "number",
            "default": 0
        },
        "backgroundColor": {
            "type": "string",
            "default": ""
        },
        "padding": {
            "type": "string",
            "default": ""
        },
        "margin": {
            "type": "string",
            "default": ""
        }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./style.css",
    "style": "file:./style.css",
    "render": "file:./template.php"
}
