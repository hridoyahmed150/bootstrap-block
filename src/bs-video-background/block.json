{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bootstrap-blocks/bs-video-background",
    "version": "1.0.0",
    "title": "BS Video Background",
    "category": "media",
    "icon": "video-alt3",
    "description": "Video background block with YouTube/Vimeo and local video support, parallax effects, and overlay options.",
    "keywords": ["video", "background", "youtube", "vimeo", "parallax"],
    "textdomain": "bootstrap-blocks",
    "supports": {
        "html": false,
        "className": true,
        "align": ["wide", "full"]
    },
    "attributes": {
        "videoType": {
            "type": "string",
            "default": "yt_vm_video"
        },
        "videoURL": {
            "type": "string",
            "default": ""
        },
        "videoMp4": {
            "type": "string",
            "default": ""
        },
        "videoWebm": {
            "type": "string",
            "default": ""
        },
        "videoOgv": {
            "type": "string",
            "default": ""
        },
        "videoPoster": {
            "type": "string",
            "default": ""
        },
        "videoStartTime": {
            "type": "number",
            "default": 0
        },
        "videoEndTime": {
            "type": "number",
            "default": 0
        },
        "videoVolume": {
            "type": "number",
            "default": 0
        },
        "videoLoop": {
            "type": "boolean",
            "default": true
        },
        "videoAlwaysPlay": {
            "type": "boolean",
            "default": true
        },
        "videoMobile": {
            "type": "boolean",
            "default": false
        },
        "videoPlayOnlyVisible": {
            "type": "boolean",
            "default": false
        },
        "parallax": {
            "type": "string",
            "default": ""
        },
        "parallaxSpeed": {
            "type": "number",
            "default": 0.5
        },
        "parallaxMobile": {
            "type": "boolean",
            "default": false
        },
        "mouseParallax": {
            "type": "boolean",
            "default": false
        },
        "mouseParallaxSize": {
            "type": "number",
            "default": 30
        },
        "mouseParallaxSpeed": {
            "type": "number",
            "default": 10000
        },
        "overlayColor": {
            "type": "string",
            "default": ""
        },
        "overlayOpacity": {
            "type": "number",
            "default": 0
        },
        "fullHeight": {
            "type": "boolean",
            "default": false
        },
        "fullHeightAlign": {
            "type": "string",
            "default": "center"
        },
        "backgroundColor": {
            "type": "string",
            "default": ""
        },
        "padding": {
            "type": "string",
            "default": ""
        },
        "margin": {
            "type": "string",
            "default": ""
        }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./style.css",
    "style": "file:./style.css",
    "render": "file:./template.php"
}
