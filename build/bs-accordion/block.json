{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bootstrap-blocks/bs-accordion",
  "version": "1.0.0",
  "title": "BS Accordion",
  "category": "bootstrap-blocks",
  "icon": "editor-ul",
  "description": "A customizable accordion/FAQ block with multiple items, styling options, and interactive behavior.",
  "keywords": [
    "accordion",
    "faq",
    "collapse",
    "bootstrap"
  ],
  "textdomain": "bootstrap-blocks",
  "editorScript": "file:../../build/bs-accordion/index.js",
  "editorStyle": "file:../../build/style-bs-accordion.css",
  "style": "file:../../build/style-bs-accordion.css",
  "attributes": {
    "items": {
      "type": "array",
      "default": [
        {
          "id": "item-1",
          "title": "Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit, Sed Do Eiusmod?",
          "content": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
          "isOpen": true
        },
        {
          "id": "item-2",
          "title": "Excepteur Sint Occaecat Cupidatat Non Proident, Sunt In Culpa Qui Officia Deserunt?",
          "content": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
          "isOpen": false
        },
        {
          "id": "item-3",
          "title": "Ut Enim Ad Minim Veniam, Quis Nostrud Exercitation Ullamco Laboris?",
          "content": "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.",
          "isOpen": false
        }
      ]
    },
    "allowMultipleOpen": {
      "type": "boolean",
      "default": true
    },
    "showNumbering": {
      "type": "boolean",
      "default": true
    },
    "iconStyle": {
      "type": "string",
      "default": "plus-minus"
    },
    "backgroundColor": {
      "type": "string",
      "default": "#EAF9FF"
    },
    "textColor": {
      "type": "string",
      "default": "#333333"
    },
    "activeBackgroundColor": {
      "type": "string",
      "default": "#34B0E3"
    },
    "activeTextColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "itemSpacing": {
      "type": "number",
      "default": 8
    },
    "blockId": {
      "type": "string",
      "default": ""
    },
    "itemPadding": {
      "type": "string",
      "default": ""
    },
    "iconColor": {
      "type": "string",
      "default": ""
    },
    "iconBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "iconBackgroundWidth": {
      "type": "string",
      "default": ""
    },
    "iconBackgroundHeight": {
      "type": "string",
      "default": ""
    },
    "iconSize": {
      "type": "string",
      "default": ""
    },
    "showIconBorder": {
      "type": "boolean",
      "default": false
    },
    "iconBorderWidth": {
      "type": "string",
      "default": ""
    },
    "iconBorderColor": {
      "type": "string",
      "default": ""
    },
    "iconBorderStyle": {
      "type": "string",
      "default": "solid"
    },
    "iconBorderRadius": {
      "type": "string",
      "default": ""
    },
    "imageHeightOpen": {
      "type": "string",
      "default": ""
    },
    "imageWidth": {
      "type": "string",
      "default": ""
    },
    "imageHeightClosed": {
      "type": "string",
      "default": ""
    },
    "titleFontSize": {
      "type": "string",
      "default": ""
    },
    "titlePadding": {
      "type": "string",
      "default": ""
    },
    "animationEnabled": {
      "type": "boolean",
      "default": false
    },
    "animationName": {
      "type": "string",
      "default": ""
    },
    "animationDuration": {
      "type": "number",
      "default": 1000
    },
    "animationDelay": {
      "type": "number",
      "default": 0
    },
    "childAnimationEnabled": {
      "type": "boolean",
      "default": false
    },
    "childAnimationInitialDelay": {
      "type": "number",
      "default": 0
    },
    "childAnimationInterval": {
      "type": "number",
      "default": 0
    },
    "showBorder": {
      "type": "boolean",
      "default": false
    },
    "borderWidth": {
      "type": "string",
      "default": ""
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "borderStyle": {
      "type": "string",
      "default": "solid"
    },
    "borderTop": {
      "type": "string",
      "default": ""
    },
    "borderBottom": {
      "type": "string",
      "default": ""
    },
    "borderLeft": {
      "type": "string",
      "default": ""
    },
    "borderRight": {
      "type": "string",
      "default": ""
    },
    "showBoxShadow": {
      "type": "boolean",
      "default": true
    },
    "boxShadow": {
      "type": "string",
      "default": ""
    },
    "borderRadius": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  }
}