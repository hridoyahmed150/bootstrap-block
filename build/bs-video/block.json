{
  "apiVersion": 2,
  "name": "bootstrap-blocks/bs-video",
  "title": "BS Video",
  "category": "embed",
  "icon": "video-alt3",
  "description": "Embed YouTube and Vimeo videos with Bootstrap responsive ratio.",
  "supports": {
    "html": false,
    "className": true
  },
  "attributes": {
    "videoURL": {
      "type": "string",
      "default": ""
    },
    "embedURL": {
      "type": "string",
      "default": ""
    },
    "provider": {
      "type": "string",
      "default": ""
    },
    "bootstrapVersion": {
      "type": "boolean",
      "default": true
    },
    "aspectRatio": {
      "type": "string",
      "default": "16x9"
    },
    "videoTitle": {
      "type": "string",
      "default": "Video"
    },
    "lazyLoad": {
      "type": "boolean",
      "default": false
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css"
}